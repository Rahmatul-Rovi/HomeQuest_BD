generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Listing {
  id              String   @id @default(cuid())
  title           String
  description     String
  listingType     ListingType
  category        Category
  price           Int
  bedroom         Int?
  bathroom        Int?
  areaSize        Int?
  bachelorAllowed Boolean  @default(true)
  address         String
  lat             Float?
  lng             Float?
  images          String[]
  status          ListingStatus @default(ACTIVE)
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id])
  createdAt       DateTime @default(now())
}

enum ListingType {
  RENT
  SALE
}

enum Category {
  FULL_FLAT
  MESS
  SEAT
  SUBLET
  FLAT_SALE
  LAND_SALE
}

enum ListingStatus {
  ACTIVE
  RENTED
  SOLD
  PENDING
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(TENANT)
  verified      Boolean   @default(false)
  listings      Listing[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  TENANT
  OWNER
  ADMIN
}